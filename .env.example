HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ---------------------------------------------------------------------------
# Form notification emails (Resend)
# ---------------------------------------------------------------------------
# Server-side only. Never expose these to the frontend.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Awaiting the client's production address; its domain must be
# verified in Resend before production sending will work.
# Development only: EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM=

# Recipients, resolved server-side per form. The frontend never supplies these.
INVESTOR_FORM_EMAIL=jchoi@irinc.ca
COMPANY_FORM_EMAIL=jjobin@irinc.ca
STUDENT_SPONSORSHIP_EMAIL=Ada@irinc.ca

# Reserved for the future Press Release form (not implemented yet).
# PRESS_RELEASE_FORM_EMAIL=sydney@irinc.ca

# Timezone used to render "Submitted" in notification emails.
EMAIL_TIMEZONE=America/Toronto

# Public origin of this Strapi instance, used to build absolute media URLs in
# notification emails (e.g. https://api.example.com).
PUBLIC_URL=

# Window in which an identical submission (same form + email) is treated as a
# double submit and silently de-duplicated. Set to 0 to disable.
FORM_DUPLICATE_WINDOW_MS=30000

# ---------------------------------------------------------------------------
# Mailchimp Marketing Audiences
# ---------------------------------------------------------------------------
# Server-side only. Never expose these to the frontend.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=

# Existing general subscriber audience
MAILCHIMP_SUBSCRIBER_AUDIENCE_ID=
MAILCHIMP_AUDIENCE_ID=

# Company registration audience
MAILCHIMP_COMPANY_AUDIENCE_ID=

# Investor registration audience
MAILCHIMP_INVESTOR_AUDIENCE_ID=

# Student sponsorship audience
MAILCHIMP_STUDENT_AUDIENCE_ID=

# Optional Customer Journey API trigger
MAILCHIMP_JOURNEY_ID=
MAILCHIMP_JOURNEY_STEP_ID=

# Optional tags
MAILCHIMP_SUBSCRIBER_TAG=Mining Investment Event
MAILCHIMP_COMPANY_TAG=Company Registration
MAILCHIMP_INVESTOR_TAG=Investor Registration
MAILCHIMP_STUDENT_TAG=Student Sponsorship

# Set to false to stop the bootstrap from revoking Public role permissions on
# the form content types. Leave unset in production.
# LOCK_FORM_PUBLIC_PERMISSIONS=true


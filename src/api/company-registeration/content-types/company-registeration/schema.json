{
  "kind": "collectionType",
  "collectionName": "company_registerations",
  "info": {
    "singularName": "company-registeration",
    "pluralName": "company-registrations",
    "displayName": "Company Registration"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "companyName": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "marketCap": {
      "type": "string",
      "maxLength": 100
    },
    "primaryExchangeTicker": {
      "type": "string",
      "maxLength": 100
    },
    "commodity": {
      "type": "string",
      "maxLength": 200
    },
    "location": {
      "type": "string",
      "maxLength": 200
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 254
    },
    "projectStage": {
      "type": "enumeration",
      "enum": [
        "Explorer",
        "Developer",
        "Producer",
        "Royalty",
        "Project Generator"
      ]
    },
    "tellUsAboutYourself": {
      "type": "text",
      "maxLength": 5000
    },
    "newsletterOptIn": {
      "type": "boolean",
      "default": false
    },
    "emailStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "failed"],
      "default": "pending"
    },
    "emailSentAt": {
      "type": "datetime"
    },
    "emailError": {
      "type": "text",
      "maxLength": 1000
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "subscribers",
  "info": {
    "singularName": "subscriber",
    "pluralName": "subscribers",
    "displayName": "subscriber"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": true
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Subscribed",
        "Unsubscribed",
        "Failed"
      ],
      "default": "Subscribed"
    },
    "mailchimpStatus": {
      "type": "string"
    },
    "mailchimpMemberId": {
      "type": "string"
    },
    "mailchimpError": {
      "type": "text"
    },
    "subscribedAt": {
      "type": "datetime"
    }
  }
}

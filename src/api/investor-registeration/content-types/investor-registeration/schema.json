{
  "kind": "collectionType",
  "collectionName": "investor_registerations",
  "info": {
    "singularName": "investor-registeration",
    "pluralName": "investor-registrations",
    "displayName": "Investor Registration"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "companyName": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "firstName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "businessTitle": {
      "type": "string",
      "maxLength": 150
    },
    "city": {
      "type": "string",
      "maxLength": 100
    },
    "country": {
      "type": "string",
      "maxLength": 100
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 254
    },
    "phone": {
      "type": "string",
      "maxLength": 50
    },
    "assetsUnderManagement": {
      "type": "enumeration",
      "enum": [
        "Under $10 Million",
        "From $10 Million - $50 Million",
        "From $50 Million - $250 Million",
        "From $250 Million - $1 Billion",
        "Over $1 Billion",
        "HNWI / Personal Accredited Investor"
      ]
    },
    "investorType": {
      "type": "enumeration",
      "enum": [
        "Institutional Investor",
        "Family Office",
        "High Net Worth Individual (HNWI)",
        "Fund / Portfolio Manager",
        "Sovereign Wealth Fund",
        "Mining Analyst / Investment Banker",
        "Retail / Accredited Investor"
      ]
    },
    "tellUsAboutYourself": {
      "type": "text",
      "maxLength": 5000
    },
    "newsletterOptIn": {
      "type": "boolean",
      "default": false
    },
    "emailStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "failed"],
      "default": "pending"
    },
    "emailSentAt": {
      "type": "datetime"
    },
    "emailError": {
      "type": "text",
      "maxLength": 1000
    },
    "mailchimpStatus": {
      "type": "enumeration",
      "enum": ["pending", "synced", "failed"],
      "default": "pending"
    },
    "mailchimpMemberId": {
      "type": "string"
    },
    "mailchimpSyncedAt": {
      "type": "datetime"
    },
    "mailchimpError": {
      "type": "text",
      "maxLength": 1000
    },
    "sourceWebsite": {
      "type": "string",
      "maxLength": 120,
      "default": "Mining Investment Event"
    }
  }
}

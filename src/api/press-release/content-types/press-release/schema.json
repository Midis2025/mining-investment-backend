{
  "kind": "collectionType",
  "collectionName": "press_releases",
  "info": {
    "singularName": "press-release",
    "pluralName": "press-releases",
    "displayName": "press-release"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "shortDescription": {
      "type": "string"
    },
    "isFeatured": {
      "type": "boolean"
    },
    "pdfFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "longDescription": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "publishTo": {
      "type": "enumeration",
      "enum": [
        "Mining Investment Event",
        "International Mining Week",
        "Noble Mining Conference"
      ]
    }
  }
}

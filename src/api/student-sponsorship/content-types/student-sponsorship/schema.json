{
  "kind": "collectionType",
  "collectionName": "student_sponsorships",
  "info": {
    "singularName": "student-sponsorship",
    "pluralName": "student-sponsorships",
    "displayName": "Student Sponsorship"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 254
    },
    "phone": {
      "type": "string",
      "maxLength": 50
    },
    "schoolInstitution": {
      "type": "string",
      "maxLength": 200
    },
    "programYearOfStudy": {
      "type": "string",
      "maxLength": 200
    },
    "preferredLanguage": {
      "type": "enumeration",
      "enum": [
        "English",
        "Francias",
        "Bilingual"
      ]
    },
    "resumeCv": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "letterOfInterest": {
      "type": "text",
      "maxLength": 10000
    },
    "transcript": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "newsletterOptIn": {
      "type": "boolean",
      "default": false
    },
    "emailStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "failed"],
      "default": "pending"
    },
    "emailSentAt": {
      "type": "datetime"
    },
    "emailError": {
      "type": "text",
      "maxLength": 1000
    }
  }
}
